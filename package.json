{
  "name": "claude-artifact-extractor",
  "version": "0.1.0",
  "description": "Tampermonkey userscript that extracts Claude research artifacts to Markdown, preserving inline references that the native export drops.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "pnpm": ">=10",
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/greasemonkey": "^4.0.7",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vite-plugin-monkey": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
